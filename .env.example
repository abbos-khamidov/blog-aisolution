# Web Push (browser notifications for new posts)
# Generate a real pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@aisolution.uz

# Admin panel (/admin). Leave empty to keep it switched off.
# On the server put these in .env.production (standalone build ignores .env.local) — see docs/ADMIN.md.
# 1) npm run admin:hash -- "your-long-password"   → paste the output here
ADMIN_PASSWORD_HASH=
# 2) 32+ random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
